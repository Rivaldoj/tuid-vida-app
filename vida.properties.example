# Copiar como vida.properties (NO se sube a git) y completar.
# URL base del backend Vida v2 (opcional; por defecto produccion)
baseUrl=https://api.autenticartuid.com/vida/v2
# Token de la marca blanca (header Authorization). Secreto: no compartir ni commitear.
token=
# Numero del proyecto de Google Cloud vinculado a la app en Play Console (Play Integrity). 0 = desactivado.
playCloudProject=0
# Identificar por CUIL (requiere los cambios de backend ya desplegados). false = DNI + sexo.
useCuilApi=false
