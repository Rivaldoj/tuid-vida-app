<?xml version="1.0" encoding="utf-8"?>
<!-- Solo debug. Pantalla 2 del registro con DNI nuevo: claves de acceso al chip (MRZ por camara o CAN a mano). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorPrimary"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/oswald"
        android:text="Claves de acceso DNI NFC"
        android:textAllCaps="true"
        android:textColor="#FFFFFF"
        android:textSize="26sp" />

    <View
        android:layout_width="120dp"
        android:layout_height="4dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="18dp"
        android:background="@drawable/subrayado_titulo" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/hoja_blanca"
        android:orientation="vertical">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="22dp"
                android:paddingEnd="18dp"
                android:paddingBottom="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Para autorizar la lectura del chip, elija cómo cargar las claves de su DNI."
                    android:textColor="@color/tu_tinta"
                    android:textSize="18sp" />

                <!-- Via camara (MRZ, dorso) -->
                <LinearLayout
                    android:id="@+id/card_via_camara"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/tarjeta_aviso"
                    android:gravity="center_vertical"
                    android:minHeight="110dp"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="84dp"
                        android:layout_height="84dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_nfc_mrz" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Vía cámara (Dorso)"
                            android:textColor="@color/tu_tinta"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Escanee la zona de lectura mecánica (código MRZ de líneas con caracteres &lt;)."
                            android:textColor="@color/tu_tinta"
                            android:textSize="15sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Via manual (CAN, frente) -->
                <LinearLayout
                    android:id="@+id/card_via_manual"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/tarjeta_aviso"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="84dp"
                            android:layout_height="84dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_nfc_can" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Vía manual (CAN - Frente)"
                                android:textColor="@color/tu_tinta"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Escriba el código de 6 dígitos que está en el frente, abajo a la derecha."
                                android:textColor="@color/tu_tinta"
                                android:textSize="15sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <EditText
                        android:id="@+id/can_campo"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/tarjeta_aviso"
                        android:fontFamily="@font/oswald"
                        android:gravity="center"
                        android:hint="– – – – – –"
                        android:importantForAutofill="no"
                        android:inputType="number"
                        android:letterSpacing="0.4"
                        android:maxLength="6"
                        android:textColor="@color/tu_tinta"
                        android:textSize="26sp" />

                    <TextView
                        android:id="@+id/can_error"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="El CAN tiene 6 números."
                        android:textColor="#e63936"
                        android:textSize="15sp"
                        android:visibility="gone" />

                    <Button
                        android:id="@+id/can_continuar"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/boton_pildora"
                        android:fontFamily="@font/oswald"
                        android:text="Usar este código"
                        android:textAllCaps="true"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:text="Presione la opción deseada"
                    android:textColor="@color/tu_tinta"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</LinearLayout>
