<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Solo debug: permite http contra servidores de QA/desarrollo -->
    <application
        android:usesCleartextTraffic="true"
        tools:replace="android:usesCleartextTraffic">
        <!-- Solo debug: segundo icono "NFC Test" para probar la lectura del chip de un documento -->
        <activity
            android:name="com.autenticar.tuid.v2.nfc.NfcTestActivity"
            android:label="NFC Test"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.autenticar.tuid.v2.nfc.MrzScanActivity"
            android:exported="false"
            android:theme="@style/AppTheme.NoActionBar"
            android:screenOrientation="sensorLandscape" />
    </application>
</manifest>
