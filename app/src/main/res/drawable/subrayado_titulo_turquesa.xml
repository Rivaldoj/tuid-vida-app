<?xml version="1.0" encoding="utf-8"?>
<!-- Subrayado de los titulos sobre fondo blanco (mismo trazo que subrayado_titulo, en turquesa #01acc2): un tramo grueso corto y una linea fina que sigue -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="120dp"
        android:height="1.5dp"
        android:gravity="center_vertical|start">
        <shape android:shape="rectangle">
            <solid android:color="#01ACC2" />
        </shape>
    </item>
    <item
        android:width="38dp"
        android:height="4dp"
        android:gravity="center_vertical|start">
        <shape android:shape="rectangle">
            <solid android:color="#01ACC2" />
            <corners android:radius="2dp" />
        </shape>
    </item>
</layer-list>
