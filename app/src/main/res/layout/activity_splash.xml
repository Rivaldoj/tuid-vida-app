<?xml version="1.0" encoding="utf-8"?>
<!-- Bienvenida. Logo arriba, foto en el centro y el boton de sonido bien arriba de la barra del telefono.
     Los ids no cambian: SplashActivity los sigue usando igual. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/logo_bienvenida"
        android:layout_width="wrap_content"
        android:layout_height="96dp"
        android:layout_marginTop="12dp"
        android:adjustViewBounds="true"
        android:contentDescription="TuID Vida"
        android:scaleType="fitCenter"
        android:src="@drawable/logo_tuid_vida" />

    <ImageView
        android:id="@+id/imgSplash"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:contentDescription="Bienvenida"
        android:padding="16dp"
        android:scaleType="fitCenter"
        android:src="@drawable/bienvenida_mujer" />

    <LinearLayout
        android:id="@+id/btn_sound"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="48dp"
        android:background="@drawable/boton_pildora"
        android:gravity="center_vertical"
        android:minHeight="60dp"
        android:orientation="horizontal"
        android:paddingStart="26dp"
        android:paddingTop="6dp"
        android:paddingEnd="26dp"
        android:paddingBottom="10dp">

        <ImageView
            android:id="@+id/img_sound"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/ic_sound_off_white" />

        <TextView
            android:id="@+id/text_sound"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:fontFamily="@font/oswald"
            android:text="@string/modal_sonido_configuracion_titulo"
            android:textAllCaps="true"
            android:textColor="@color/white"
            android:textSize="19sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/splash_testing"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TESTING"
        android:textColor="@color/colorPrimary"
        android:textSize="30sp"
        android:textStyle="bold"
        android:visibility="gone" />
</LinearLayout>
