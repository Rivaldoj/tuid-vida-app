<?xml version="1.0" encoding="utf-8"?>
<!-- Cuadro de aviso con estilo "D": titulo en Oswald, botones pildora grandes dentro del cuadro.
     Lo usan SelectorUsuario, Cuadro, ComprobarRegistro y Soporte (los ids no cambian). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="26dp"
    android:paddingEnd="24dp"
    android:paddingBottom="18dp">

    <!-- Icono opcional (por ejemplo "Sin conexion"); oculto salvo que Cuadro lo pida -->
    <ImageView
        android:id="@+id/picker_icono"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginBottom="10dp"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <TextView
        android:id="@+id/picker_titulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/oswald"
        android:textAllCaps="true"
        android:textColor="@color/tu_tinta"
        android:textSize="26sp" />

    <TextView
        android:id="@+id/picker_mensaje"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingMultiplier="1.1"
        android:textColor="#46585C"
        android:textSize="18sp" />

    <Spinner
        android:id="@+id/picker_spinner"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/campo_redondo"
        android:paddingStart="8dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/picker_unico"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/campo_redondo"
        android:padding="14dp"
        android:textColor="@color/tu_tinta"
        android:textSize="19sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <EditText
        android:id="@+id/picker_cuil"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/campo_redondo"
        android:digits="0123456789- "
        android:hint="CUIL (11 números)"
        android:importantForAutofill="no"
        android:inputType="number"
        android:maxLength="14"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="@color/tu_tinta"
        android:textColorHint="#7A8A8E"
        android:textSize="20sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/picker_ayuda"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Su CUIL figura en su recibo de haberes o en su constancia de ANSES."
        android:textColor="#46585C"
        android:textSize="16sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/picker_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#B3201E"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Botones grandes y visibles dentro del cuadro (principal, secundario y cancelar) -->
    <Button
        android:id="@+id/picker_principal"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/boton_pildora"
        android:fontFamily="@font/oswald"
        android:letterSpacing="0.05"
        android:textAllCaps="true"
        android:textColor="#FFFFFF"
        android:textSize="20sp" />

    <Button
        android:id="@+id/picker_secundario"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/boton_pildora_borde"
        android:fontFamily="@font/oswald"
        android:letterSpacing="0.05"
        android:textAllCaps="true"
        android:textColor="@color/tu_tinta"
        android:textSize="19sp"
        android:visibility="gone" />

    <Button
        android:id="@+id/picker_cancelar"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="6dp"
        android:background="@android:color/transparent"
        android:fontFamily="@font/oswald"
        android:text="Cancelar"
        android:textAllCaps="true"
        android:textColor="@color/tu_tinta"
        android:textSize="17sp" />
</LinearLayout>
