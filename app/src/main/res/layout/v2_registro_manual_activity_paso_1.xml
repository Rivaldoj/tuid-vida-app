<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:padding="5dp"
    android:background="@color/colorPrimary"
    android:layout_height="match_parent">


    <androidx.cardview.widget.CardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="10dp"
        app:cardCornerRadius="50dp"
        >

        <ImageView
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@drawable/logovidanoti"/>

    </androidx.cardview.widget.CardView>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Registración asistida"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:textSize="20sp"/>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:layout_marginVertical="5dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="50dp"
            android:layout_height="5dp"
            android:background="@color/white"/>

        <LinearLayout
            android:layout_width="50dp"
            android:layout_height="2dp"
            android:background="@color/white"/>


    </LinearLayout>


    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="10dp"
        android:layout_margin="10dp"
        android:layout_weight="1">

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:columnCount="2"
            android:rowCount="5"
            android:padding="10dp"
            >

            <ImageView
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_gravity="center_vertical"
                android:layout_columnWeight="1"
                android:adjustViewBounds="true"
                android:layout_rowWeight="1"
                android:src="@drawable/dni_frente"/>


            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_columnWeight="3"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_rowWeight="1"
                android:text="El primer paso consiste en tomar una fotografía o subir una imagen de su DNI"/>


            <ImageView
                android:layout_marginTop="10sp"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_gravity="center_vertical"
                android:adjustViewBounds="true"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:src="@drawable/scan_dni_icon"/>


            <TextView
                android:layout_marginTop="10sp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:textStyle="bold"
                android:layout_rowWeight="1"
                android:textSize="16sp"
                android:layout_columnWeight="3"
                android:text="Comenzamos capturando el frente del DNI"/>


            <ImageView
                android:layout_marginTop="10sp"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_rowWeight="1"
                android:layout_gravity="center_vertical"
                android:layout_columnWeight="1"
                android:src="@drawable/girar_dni_icon"/>


            <TextView
                android:layout_marginTop="10sp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_rowWeight="1"
                android:layout_gravity="center_vertical"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_columnWeight="3"
                android:text="Girar el Documento"/>


            <ImageView
                android:layout_marginTop="10sp"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_rowWeight="1"
                android:layout_gravity="center_vertical"
                android:layout_columnWeight="1"
                android:src="@drawable/scan_dni_icon"/>


            <TextView
                android:layout_marginTop="10sp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_rowWeight="1"
                android:layout_gravity="center_vertical"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_columnWeight="3"
                android:text="Luego capturamos el dorso del DNI"/>


            <ImageView
                android:layout_marginTop="10sp"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_gravity="center_vertical"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:src="@drawable/selfie_icon"/>


            <TextView
                android:layout_marginTop="10sp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_rowWeight="1"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_columnWeight="3"
                android:text="Por último se debe tomar una SELFIE mediante detección de movimientos"/>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_columnSpan="2"
                android:layout_rowWeight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/layout_terminos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/paso_1"
                    android:layout_columnSpan="2"
                    android:layout_alignParentLeft="true"
                    android:layout_alignParentRight="true"
                    android:layout_marginTop="5dp"
                    android:gravity="center_horizontal"
                    android:orientation="horizontal"
                    android:paddingLeft="5dp">

                    <CheckBox
                        android:id="@+id/checkbox_terminos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/checkbox_terminos_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignTop="@+id/layout_terminos"
                        android:layout_marginLeft="3dp"
                        android:layout_marginBottom="@dimen/padding"
                        android:text="@string/label_terminos_text" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_politicas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_columnSpan="2"
                    android:layout_below="@id/layout_terminos"
                    android:layout_alignParentLeft="true"
                    android:layout_alignParentEnd="false"
                    android:layout_alignParentRight="true"
                    android:gravity="center_horizontal"
                    android:orientation="horizontal"
                    android:textAlignment="center">

                    <CheckBox
                        android:id="@+id/checkbox_politicas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/checkbox_politicas_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="5dp"
                        android:layout_marginBottom="@dimen/padding"
                        android:text="@string/label_politicas_text" />
                </LinearLayout>


            </LinearLayout>


            <Button
                android:id="@+id/continuar"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_columnSpan="2"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:background="@drawable/round_primary_button"
                android:text="Continuar"
                android:textSize="17sp"
                android:layout_margin="4dp"
                android:textStyle="bold" />

        </GridLayout>

    </androidx.cardview.widget.CardView>

</LinearLayout>