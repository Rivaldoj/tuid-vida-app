<?xml version="1.0" encoding="utf-8"?>
<!-- Codigo de verificacion. Estilo "D": cabecera turquesa, hoja blanca redondeada. Los ids no cambian (los usa ValidarTelefonoMail). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorPrimary"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/oswald"
        android:text="Código"
        android:textAllCaps="true"
        android:textColor="#FFFFFF"
        android:textSize="30sp" />

    <View
        android:layout_width="120dp"
        android:layout_height="4dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="18dp"
        android:background="@drawable/subrayado_titulo" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/hoja_blanca"
        android:orientation="vertical">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="22dp"
                android:paddingEnd="18dp"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/tarjeta_aviso"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <ImageView
                        android:id="@+id/imgEmailSms"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:importantForAccessibility="no"
                        android:scaleType="centerInside" />

                    <TextView
                        android:id="@+id/textCodigoEnvio"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:lineSpacingMultiplier="1.1"
                        android:text="@string/explicacion_registro_validacion"
                        android:textColor="@color/tu_tinta"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/prompt_codigo_validacion"
                    android:textColor="@color/tu_tinta"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/editCodigoValidacion"
                    android:layout_width="match_parent"
                    android:layout_height="68dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/campo_redondo"
                    android:gravity="center"
                    android:hint="_ _ _ _"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:letterSpacing="0.3"
                    android:maxLength="4"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:textColor="@color/tu_tinta"
                    android:textColorHint="#7A8A8E"
                    android:textSize="28sp" />

                <TextView
                    android:id="@+id/textCodigoEnvioAviso"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:lineSpacingMultiplier="1.1"
                    android:text="@string/formulario_validacion_email"
                    android:textColor="#46585C"
                    android:textSize="16sp" />

            </LinearLayout>
        </ScrollView>

        <Button
            android:id="@+id/btnSendCodeValidation"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:layout_marginStart="18dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="18dp"
            android:layout_marginBottom="18dp"
            android:background="@drawable/boton_pildora"
            android:fontFamily="@font/oswald"
            android:letterSpacing="0.05"
            android:text="Verificar"
            android:textAllCaps="true"
            android:textColor="#FFFFFF"
            android:textSize="20sp" />
    </LinearLayout>
</LinearLayout>
