<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:openDrawer="start"
    android:background="@color/white">

   <include
       android:id="@+id/fragment_registrar_user_terminos"
        layout="@layout/fragment_registrar_user_terminos"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible"/>
   <include
       android:id="@+id/fragment_registrar_user_scaner_data"
        layout="@layout/fragment_registrar_user_scaner_data"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"/>
    <include
        android:id="@+id/fragment_registrar_user_fe_vida"
        layout="@layout/fragment_registrar_user_fe_vida"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"/>
    <include
        android:id="@+id/fragment_registrar_confirmacion"
        layout="@layout/fragment_registrar_confirmacion"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"/>
    <include
        android:id="@+id/fragment_registrar_formulario_email_movil"
        layout="@layout/fragment_registrar_formulario_email_movil"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"/>
    <include
        android:id="@+id/fragment_registrar_formulario_validacion"
        layout="@layout/fragment_registrar_formulario_validacion"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"/>
    <include
        android:id="@+id/fragment_registrar_formulario_selection"
        layout="@layout/fragment_registrar_formulario_selection"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"/>

    <include
        layout="@layout/app_bar_main_"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:fitsSystemWindows="true"
        app:headerLayout="@layout/nav_header_main_"
        app:menu="@menu/activity_main_menu_drawer" >
        <include layout="@layout/nav_footer"></include>
    </com.google.android.material.navigation.NavigationView>
</androidx.drawerlayout.widget.DrawerLayout >