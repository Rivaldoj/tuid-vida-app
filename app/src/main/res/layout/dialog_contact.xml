<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="15sp"
    android:background="@color/colorTransTotal"
    android:gravity="center"
    android:orientation="vertical">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/style_rect"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingVertical="5dp"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/btn_return"
                android:layout_width="30sp"
                android:layout_height="30sp"
                android:layout_marginLeft="5sp"
                android:src="@drawable/ico_return_primary" />
            <TextView
                android:id="@+id/text_title_info_empresarial"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textSize="18sp"
                android:textColor="@color/colorPrimary"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btn_cancel"
                android:layout_width="30sp"
                android:layout_height="30sp"
                android:layout_marginRight="5sp"
                android:src="@drawable/ico_cancel_primary" />
        </LinearLayout>

        <include
            layout="@layout/fragment_contact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
</LinearLayout>

