<?xml version="1.0" encoding="utf-8"?>
<!-- Contacto (correo o celular). Estilo "D": cabecera turquesa, hoja blanca redondeada. Los ids no cambian (los usa ValidarTelefonoMail). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorPrimary"
    android:orientation="vertical">

    <TextView
        android:id="@+id/v2_validar_titulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/oswald"
        android:text="Contacto"
        android:textAllCaps="true"
        android:textColor="#FFFFFF"
        android:textSize="30sp" />

    <View
        android:layout_width="120dp"
        android:layout_height="4dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="18dp"
        android:background="@drawable/subrayado_titulo" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/hoja_blanca"
        android:orientation="vertical">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="22dp"
                android:paddingEnd="18dp"
                android:paddingBottom="8dp">

                <TextView
                    android:id="@+id/v2_validar_telefono_mail_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingMultiplier="1.1"
                    android:text="Para completar su registro indique su correo electrónico. Recibirá un código de verificación."
                    android:textColor="@color/tu_tinta"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/v2_validar_telefono_mail_telefono_mail_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/optSendMail"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:checked="true"
                        android:visibility="gone" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/txtEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        app:hintEnabled="false">

                        <EditText
                            android:id="@+id/editEmail"
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:background="@drawable/campo_redondo"
                            android:hint="Correo electrónico"
                            android:importantForAutofill="no"
                            android:inputType="textEmailAddress|textNoSuggestions"
                            android:maxLines="1"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:singleLine="true"
                            android:textColor="@color/tu_tinta"
                            android:textColorHint="#7A8A8E"
                            android:textSize="20sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/txtEmailConfirmar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        app:hintEnabled="false">

                        <EditText
                            android:id="@+id/editEmailConfirmar"
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:background="@drawable/campo_redondo"
                            android:hint="Repita su correo electrónico"
                            android:importantForAutofill="no"
                            android:inputType="textEmailAddress|textNoSuggestions"
                            android:maxLines="1"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:singleLine="true"
                            android:textColor="@color/tu_tinta"
                            android:textColorHint="#7A8A8E"
                            android:textSize="20sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/v2_validar_telefono_mail_telefono_telefono_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <RadioButton
                        android:id="@+id/optSendSMS"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone" />

                    <include
                        layout="@layout/celular_normalizado_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp" />

                    <!-- campos heredados (no se muestran) -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/txtTelefono"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone">

                        <EditText
                            android:id="@+id/editMovil"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="phone" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/txtTelfConfirmar"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone">

                        <EditText
                            android:id="@+id/editMovilConfirmar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="phone" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/v2_validar_aviso_codigo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Le enviaremos un código para comprobar que es suyo."
                    android:textColor="#46585C"
                    android:textSize="16sp" />

            </LinearLayout>
        </ScrollView>

        <Button
            android:id="@+id/btnSendValidation"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:layout_marginStart="18dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="18dp"
            android:layout_marginBottom="18dp"
            android:background="@drawable/boton_pildora"
            android:fontFamily="@font/oswald"
            android:letterSpacing="0.05"
            android:text="Enviar código"
            android:textAllCaps="true"
            android:textColor="#FFFFFF"
            android:textSize="20sp" />
    </LinearLayout>
</LinearLayout>
