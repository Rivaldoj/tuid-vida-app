<?xml version="1.0" encoding="utf-8"?>
<!-- Mensaje de alerta (con acceso a contacto): icono chico de alerta, titulo, texto y botones chicos tipo chip.
     Esquinas redondeadas en el fondo del cuadro (estilo DialogoTuID). Los ids no cambian. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="18dp"
    android:paddingEnd="20dp"
    android:paddingBottom="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/dialog_icono"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_alerta_documento" />

        <TextView
            android:id="@+id/dialog_titulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:fontFamily="@font/oswald"
            android:text="Aviso"
            android:textAllCaps="true"
            android:textColor="@color/tu_tinta"
            android:textSize="22sp" />

        <ImageView
            android:id="@+id/ok_action"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/chip_claro"
            android:contentDescription="Cerrar"
            android:elevation="2dp"
            android:padding="11dp"
            app:srcCompat="@drawable/ic_cerrar_gris" />
    </LinearLayout>

    <TextView
        android:id="@+id/dialog_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:lineSpacingMultiplier="1.1"
        android:text="texto"
        android:textColor="#46585C"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/dialog_ir_a_dar_fe_de_vida"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/chip_turquesa"
        android:elevation="3dp"
        android:gravity="center"
        android:text="Ir a dar fe de vida"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/dialog_ver_entidades_adheridas"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/chip_turquesa"
        android:elevation="3dp"
        android:gravity="center"
        android:text="Ver entidades adheridas"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/dialog_ir_a_contacto"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/chip_claro"
        android:elevation="3dp"
        android:gravity="center"
        android:text="Ir a formulario de contacto"
        android:textColor="@color/tu_tinta"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/dialog_ok"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/chip_turquesa"
        android:elevation="3dp"
        android:gravity="center"
        android:text="Aceptar"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:textStyle="bold" />
</LinearLayout>
