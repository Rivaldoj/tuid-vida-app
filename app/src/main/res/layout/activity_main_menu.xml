<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:fab="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorblanco"
    android:fitsSystemWindows="true"
    tools:openDrawer="start">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="10sp"
            android:layout_marginTop="65sp"
            android:layout_marginRight="10sp">

            <LinearLayout
                android:id="@+id/lay_perfil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/style_rect"
                android:orientation="horizontal"
                android:padding="5sp">

                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/ico_perfil"
                    android:layout_width="90sp"
                    android:layout_height="90sp"
                    android:layout_alignParentTop="true"
                    android:layout_centerHorizontal="true"
                    android:layout_gravity="center|top"
                    android:layout_margin="5sp"
                    android:src="@drawable/profile_enable"
                    android:visibility="visible"
                    app:civ_border_color="@color/colorTransBg"
                    app:civ_border_width="1sp" />


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10sp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/main_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentTop="true"
                        android:layout_centerHorizontal="true"
                        android:layout_gravity="left|top"
                        android:text="Nombre"
                        android:textColor="@color/colorPrimary"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="left"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/main_cuil"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="123456789"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="left"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/btn_cancel_1"
                            android:layout_width="20sp"
                            android:layout_height="20sp"
                            app:srcCompat="@drawable/ic_email" />

                        <TextView
                            android:id="@+id/main_email"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="5sp"
                            android:layout_weight="1"
                            android:singleLine="true"
                            android:lines="1"
                            android:maxLines="1"
                            android:textSize="14sp"
                            android:text="Email" />

                        <ImageView
                            android:layout_width="20sp"
                            android:layout_height="20sp"
                            app:srcCompat="@drawable/edit_icon"
                            android:layout_gravity="right"
                            android:tint="#C7C7C7"
                            android:onClick="editmail"
                            android:layout_marginRight="5sp"/>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5sp"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/btn_cancel_2"
                            android:layout_width="20sp"
                            android:layout_height="20sp"
                            app:srcCompat="@drawable/ic_movil" />

                        <TextView
                            android:id="@+id/main_telefono"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="5sp"
                            android:singleLine="true"
                            android:lines="1"
                            android:maxLines="1"
                            android:gravity="left"
                            android:textSize="15sp"
                            android:layout_weight="1"
                            android:text="telefono" />

                        <ImageView
                            android:onClick="editphone"
                            android:layout_width="20sp"
                            android:layout_height="20sp"
                            app:srcCompat="@drawable/edit_icon"
                            android:layout_gravity="right"
                            android:tint="#C7C7C7"
                            android:layout_marginRight="5sp"/>

                    </LinearLayout>


                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/lay_fe_vida"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/lay_perfil"
                android:layout_marginTop="3sp"
                android:background="@drawable/style_rect"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="5sp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/img_fe_vida"
                        android:layout_width="20sp"
                        android:layout_height="25sp"
                        android:layout_marginLeft="5sp"
                        android:backgroundTint="@color/colorPrimary"
                        android:background="@drawable/ic_validado" />

                    <TextView
                        android:id="@+id/fe_vida"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="5sp"
                        android:text="@string/main_bienvenida"
                        android:textColor="@color/colorPrimary"
                        android:textSize="25sp" />
                </LinearLayout>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="3sp"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ListView
                        android:id="@+id/lista_error"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/white" />

                </RelativeLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@id/lay_fe_vida"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="3sp"
                    android:layout_marginBottom="5sp"
                    android:background="@drawable/style_rect"
                    android:orientation="vertical"
                    android:padding="5sp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/main_aviso_certificado_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/main_aviso_certificado"
                            android:textColor="@color/colorAccent"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/main_aviso_certificado"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="5sp"
                            android:layout_weight="1"
                            android:text="10/08/2019" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/main_aviso_instituto"
                            android:textColor="@color/colorAccent"
                            android:textSize="14sp"
                            android:textStyle="bold" />



                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_margin="1sp"
                            android:gravity="left|center"
                            android:orientation="horizontal"
                            android:padding="3sp">

                            <LinearLayout
                                android:layout_width="2sp"
                                android:layout_height="match_parent"
                                android:background="@color/colorAccentDark"
                                android:orientation="vertical">

                            </LinearLayout>
                            <TextView
                                android:id="@+id/main_aviso_instituto"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingLeft="5sp"
                                android:text="caja"
                                android:background="@color/colorblanco"
                                android:textSize="10sp"
                                android:padding="5sp"/>

                            <TextView
                                android:id="@+id/main_aviso_aler"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:textAlignment="center"
                                android:textColor="@color/colorblanco"
                                android:textSize="10sp" />

                        </LinearLayout>

                    </LinearLayout>

                    <!--<LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/main_aviso_fecha_cobro"
                            android:textColor="@color/colorAccent"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/main_aviso_fecha_cobro"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="5sp"
                            android:text="Sin Información" />
                    </LinearLayout>-->
                </LinearLayout>
            </LinearLayout>
        </RelativeLayout>

        <View
            android:id="@+id/fabBGLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/colorTransBg"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/fabLayout1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginRight="@dimen/standard_23"
            android:layout_marginBottom="@dimen/standard_23"
            android:clipToPadding="false"
            android:gravity="center_vertical"
            android:padding="@dimen/standard_12"
            android:visibility="gone"
            app:layout_behavior="com.autenticar.tuid.utils.MoveUpwardBehavior">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Modificar datos de contacto" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fab1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10sp"
                app:backgroundTint="@color/colorAccentDark"
                app:fabSize="mini"
                app:srcCompat="@drawable/ic_user_profile" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/fabLayout2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginRight="@dimen/standard_23"
            android:layout_marginBottom="@dimen/standard_23"
            android:clipToPadding="false"
            android:gravity="center_vertical"
            android:padding="@dimen/standard_12"
            android:visibility="gone"
            app:layout_behavior="com.autenticar.tuid.utils.MoveUpwardBehavior">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Agregar información bancaria" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fab2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10sp"
                app:backgroundTint="@color/colorAccentDark"
                app:fabSize="mini"
                app:srcCompat="@drawable/mas_bank" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginRight="@dimen/fab_margin"
            android:layout_marginBottom="@dimen/fab_margin"
            android:clipToPadding="false"
            android:gravity="center_vertical"
            android:padding="@dimen/standard_12"
            app:layout_behavior="com.autenticar.tuid.utils.MoveUpwardBehavior">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:gravity="center_vertical"
                app:backgroundTint="@color/colorPrimaryDark"
                app:fabSize="normal"
                android:visibility="gone"
                app:srcCompat="@drawable/ic_mas_menos" />
        </LinearLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <include
        layout="@layout/app_bar_main_"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:headerLayout="@layout/nav_header_main_"
        app:menu="@menu/activity_menu_home" >
    <include layout="@layout/nav_footer"></include>
    </com.google.android.material.navigation.NavigationView>
</androidx.drawerlayout.widget.DrawerLayout>
