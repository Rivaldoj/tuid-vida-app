<?xml version="1.0" encoding="utf-8"?>
<!-- Cuadro de permisos (camara, ubicacion): icono de alerta, texto claro y botones tipo chip (estilo Odis) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="24dp"
    android:paddingEnd="24dp"
    android:paddingBottom="20dp">

    <ImageView
        android:id="@+id/permiso_icono"
        android:layout_width="84dp"
        android:layout_height="84dp"
        android:layout_gravity="center_horizontal"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/permiso_titulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/oswald"
        android:gravity="center"
        android:textAllCaps="true"
        android:textColor="@color/tu_tinta"
        android:textSize="25sp" />

    <TextView
        android:id="@+id/permiso_mensaje"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:lineSpacingMultiplier="1.1"
        android:textColor="#46585C"
        android:textSize="18sp" />

    <Button
        android:id="@+id/permiso_aceptar"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/chip_turquesa"
        android:elevation="3dp"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="19sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/permiso_ahora_no"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/chip_claro"
        android:elevation="3dp"
        android:text="Ahora no"
        android:textAllCaps="false"
        android:textColor="@color/tu_tinta"
        android:textSize="18sp"
        android:textStyle="bold" />
</LinearLayout>
