<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/colorblanco">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/style_rect"
        android:orientation="horizontal"
        android:layout_margin="5dp"
        android:padding="5sp">

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/ico_perfil"
            android:layout_width="90sp"
            android:layout_height="90sp"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:layout_gravity="center|top"
            android:layout_margin="5sp"
            android:src="@drawable/profile_enable"
            android:visibility="visible"
            app:civ_border_color="@color/colorTransBg"
            app:civ_border_width="1sp" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10sp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/main_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true"
                android:layout_gravity="left|top"
                android:text="Nombre"
                android:textColor="@color/colorPrimary"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="left"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/main_cuil"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="123456789"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="left"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btn_cancel_1"
                    android:layout_width="20sp"
                    android:layout_height="20sp"
                    app:srcCompat="@drawable/ic_email" />

                <TextView
                    android:id="@+id/main_email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5sp"
                    android:layout_weight="1"
                    android:singleLine="true"
                    android:lines="1"
                    android:maxLines="1"
                    android:textSize="14sp"
                    android:text="Email" />

                <ImageView
                    android:layout_width="20sp"
                    android:layout_height="20sp"
                    app:srcCompat="@drawable/edit_icon"
                    android:layout_gravity="right"
                    app:tint="#C7C7C7"
                    android:onClick="editmail"
                    android:layout_marginRight="5sp"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5sp"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btn_cancel_2"
                    android:layout_width="20sp"
                    android:layout_height="20sp"
                    app:srcCompat="@drawable/ic_movil" />

                <TextView
                    android:id="@+id/main_telefono"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5sp"
                    android:singleLine="true"
                    android:lines="1"
                    android:maxLines="1"
                    android:gravity="left"
                    android:textSize="15sp"
                    android:layout_weight="1"
                    android:text="telefono" />

                <ImageView
                    android:onClick="editphone"
                    android:layout_width="20sp"
                    android:layout_height="20sp"
                    app:srcCompat="@drawable/edit_icon"
                    android:layout_gravity="right"
                    app:tint="#C7C7C7"
                    android:layout_marginRight="5sp"/>

            </LinearLayout>


        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:background="@drawable/style_rect"
        android:padding="5dp"
        android:layout_margin="5dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/img_fe_vida"
            android:layout_width="20sp"
            android:layout_height="25sp"
            android:layout_marginLeft="5sp"
            android:backgroundTint="@color/colorPrimary"
            android:background="@drawable/ic_validado" />

        <TextView
            android:id="@+id/fe_vida"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5sp"
            android:text="@string/main_bienvenida"
            android:textColor="@color/colorPrimary"
            android:textSize="25sp" />
    </LinearLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="@drawable/style_rect"
        android:layout_margin="5dp"
        android:padding="5dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3sp"
            android:layout_marginBottom="5sp"
            android:orientation="vertical"
            android:padding="5sp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/main_aviso_certificado_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/main_aviso_certificado"
                    android:textColor="@color/colorAccent"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/main_aviso_certificado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5sp"
                    android:layout_weight="1"
                    android:text="10/08/2019" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/main_aviso_instituto"
                    android:textColor="@color/colorAccent"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:id="@+id/result_login_activity_entidades_lo">

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    android:background="@drawable/rounded_background"
                    android:padding="10dp"
                    android:backgroundTint="@color/colorPrimary"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="ATENCIÓN:"
                        android:textStyle="bold"
                        android:layout_marginTop="5dp"
                        android:gravity="center_vertical"
                        android:textColor="@color/white"
                        android:drawablePadding="15dp"
                        android:drawableLeft="@drawable/ic_baseline_error_outline_24"
                        android:drawableTint="@color/white"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:text="Toda certificación está sujeta a una revisión dentro de las 48 hs hábiles luego de ser efectuada.\nEn caso de detectarse alguna anomalía, la misma podría ser rechazada y en dicho caso usted será notificado."
                        android:textStyle="bold"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"/>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <ListView
            android:id="@+id/lista_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white" />


    </LinearLayout>



    <Button
        android:id="@+id/result_login_activity_get_certificate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="5dp"
        android:text="Ver certificado"/>




</LinearLayout>