<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorTransTotal"
    android:gravity="center"
    android:orientation="vertical">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/style_rect"
        android:paddingBottom="10dp"
        android:layout_marginHorizontal="5dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/text_title_info_empresarial"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:textSize="18sp"
                android:text="Iluminación insuficiente!"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="10sp"
                android:autoSizeMaxTextSize="18sp"
                android:autoSizeStepGranularity="2sp"
                android:layout_marginHorizontal="1dp"
                android:layout_marginVertical="4dp"
                android:textColor="@color/colorPrimary"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btn_cancel"
                android:layout_width="30sp"
                android:layout_height="30sp"
                android:visibility="invisible"
                android:layout_marginRight="5sp"
                android:src="@drawable/ico_cancel_primary" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="10dp"
            android:textSize="18sp"
            android:gravity="center"
            android:layout_marginVertical="10dp"
            android:text="No hemos podido verificar el rostro\n\nPor favor intente nuevamente en un ambiente con buena iluminación" />



        <Button
            android:id="@+id/novedad_cerrar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Aceptar"
            android:layout_gravity="center_horizontal"
            android:layout_marginVertical="10dp"/>

    </LinearLayout>
</LinearLayout>

