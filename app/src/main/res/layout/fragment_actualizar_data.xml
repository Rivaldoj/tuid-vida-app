<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/layout_contact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="15dp"
                android:gravity="top|center"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/text_info_email_1_lo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="left"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/text_info_email_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/contact_email"
                        android:textColor="@color/colorPrimary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="3dp"
                        android:text="*"
                        android:textColor="@color/colorAccentDarkSecund" />
                </LinearLayout>

                <EditText
                    android:id="@+id/text_email_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/black_2"
                    android:hint="@string/contact_email"
                    android:singleLine="true"
                    android:lines="1"
                    android:padding="10dp" />

                <LinearLayout
                    android:id="@+id/text_info_email_2_lo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="left"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/text_info_email_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Confirmar Email"
                        android:textColor="@color/colorPrimary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="3dp"
                        android:text="*"
                        android:textColor="@color/colorAccentDarkSecund" />
                </LinearLayout>

                <EditText
                    android:id="@+id/text_email_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/black_2"
                    android:singleLine="true"
                    android:lines="1"
                    android:hint="Confirmar Email"
                    android:padding="10dp" />

                <LinearLayout
                    android:id="@+id/text_info_telefono_1_lo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="left"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/text_info_telefono_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Teléfono celular"
                        android:textColor="@color/colorPrimary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="3dp"
                        android:text="*"
                        android:textColor="@color/colorAccentDarkSecund" />
                </LinearLayout>

                <EditText
                    android:id="@+id/text_telefono_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/black_2"
                    android:hint="Cód. de area + Número"
                    android:singleLine="true"
                    android:lines="1"
                    android:inputType="number"
                    android:padding="10dp" />

                <LinearLayout
                    android:id="@+id/text_info_telefono_2_lo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="left"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/text_info_telefono_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Confirmar Teléfono"
                        android:textColor="@color/colorPrimary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="3dp"
                        android:text="*"
                        android:textColor="@color/colorAccentDarkSecund" />
                </LinearLayout>

                <EditText
                    android:id="@+id/text_telefono_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/black_2"
                    android:hint="Confirmar Teléfono"
                    android:singleLine="true"
                    android:lines="1"
                    android:inputType="number"
                    android:padding="10dp" />

                <Button
                    android:id="@+id/btn_update"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/round_primary_button"
                    android:text="@string/btn_update"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>