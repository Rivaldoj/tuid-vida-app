<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#FFFFFF"
    android:padding="3dp"
    android:orientation="vertical">


    <Button
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TEST"
        android:id="@+id/v2_home_test"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"/>

    <ImageView
        android:id="@+id/lblLogo"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btnHistorial"
        android:adjustViewBounds="true"
        android:src="@drawable/banner_login" />

    <TextView
        android:id="@+id/txtVersionName"
        android:layout_width="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_height="wrap_content"
        android:text="1.0.0"
        android:textSize="12dp" />


        <Button
            android:id="@+id/btnHistorial"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/lblLogo"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@id/btnUsuarios"
            android:background="@drawable/rounded_background"
            android:textColor="#B1BCBE"
            android:layout_margin="10dp"
            android:layout_marginRight="10dp"
            android:text="Historial de\ncertificaciones"
            />


        <!-- "Cuando cobro": servicio SUSPENDIDO (no se presta por el momento). Para reactivarlo, sacar este
             comentario, volver a habilitar el click en HomeActivity y dejar a "Usuarios" debajo de la fila.
        <Button
            android:id="@+id/v2_home_cuando_cobro"
            app:layout_constraintTop_toBottomOf="@id/lblLogo"
            app:layout_constraintLeft_toRightOf="@id/btnHistorial"
            app:layout_constraintRight_toRightOf="parent"
            android:layout_width="0dp"
            android:layout_margin="10dp"
            android:layout_height="wrap_content"
            android:background="@drawable/rounded_background"
            android:textColor="#B1BCBE"
            android:text="Cuando cobro"
            android:layout_weight="1"/>
        -->


        <Button
            android:id="@+id/btnUsuarios"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/lblLogo"
            app:layout_constraintLeft_toRightOf="@id/btnHistorial"
            app:layout_constraintRight_toRightOf="parent"
            android:background="@drawable/rounded_background"
            android:textColor="#B1BCBE"
            android:layout_margin="10dp"
            android:text="Usuarios" />

        <Button
            android:id="@+id/btnLoginDBiom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/btnHistorial"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintBottom_toTopOf="@id/home_solicitar_certifiado"
            android:background="@drawable/round_primary_button"
            android:text="@string/ingreso_por_datos_biometricos"
            android:layout_margin="10dp"
            android:textSize="18sp"
            android:textStyle="bold" />


    <Button
        android:id="@+id/home_solicitar_certifiado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/btnLoginDBiom"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btnRegistrarUser"
        android:background="@color/amp_gray"
        android:visibility="gone"
        android:text="Solicitar certificado"
        android:layout_marginHorizontal="10dp"
        android:textSize="18sp"
        android:textStyle="bold" />


        <Button
            android:id="@+id/btnRegistrarUser"
            app:layout_constraintTop_toBottomOf="@id/home_solicitar_certifiado"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintBottom_toTopOf="@id/txtVersionName"
            android:layout_width="match_parent"
            android:layout_margin="10dp"
            android:layout_height="wrap_content"
            android:background="@drawable/round_accent_button"
            android:text="@string/action_register"
            android:textSize="18sp"
            android:textStyle="bold" />




</androidx.constraintlayout.widget.ConstraintLayout>