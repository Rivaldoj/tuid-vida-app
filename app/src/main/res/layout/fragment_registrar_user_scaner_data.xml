<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorblanco">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="65dp"
        android:layout_marginBottom="70dp"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingLeft="10dp"
            android:paddingRight="10dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center|top"
                android:paddingTop="5dp">

                <LinearLayout
                    android:id="@+id/layout_data"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="3dp"
                    android:background="@drawable/style_rect"
                    android:orientation="horizontal"
                    android:padding="8dp">

                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/imgDNIFotoDNI"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:src="@drawable/profile_enable"
                        app:civ_border_color="@color/colorTransBg"
                        app:civ_border_width="1dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginLeft="10dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/fullname"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Full name"
                            android:textSize="16dp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/numerodni"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="##.###.###"
                            android:textSize="14dp" />

                        <TextView
                            android:id="@+id/sexo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Sexo: M"
                            android:textSize="14dp" />

                        <TextView
                            android:id="@+id/fechaNacimiento"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Fecha Nac.: DD/MM/AAAA"
                            android:textSize="14dp" />
                    </LinearLayout>
                </LinearLayout>

                <RelativeLayout
                    android:id="@+id/layout_imagen"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/layout_data"
                    android:background="@drawable/style_rect"
                    android:gravity="center_horizontal|center"
                    android:padding="8dp">

                    <LinearLayout
                        android:id="@+id/frente_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentLeft="true"
                        android:layout_alignParentRight="true"
                        android:layout_marginTop="3dp"
                        android:gravity="center_horizontal"
                        android:orientation="horizontal"
                        android:paddingLeft="5dp">

                        <TextView
                            android:layout_width="150dp"
                            android:layout_height="wrap_content"
                            android:paddingLeft="20dp"
                            android:paddingRight="20dp"
                            android:paddingBottom="3dp"
                            android:text="Frente del DNI"
                            android:textAlignment="center"
                            android:textSize="16dp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/imgDNIFrente"
                        android:layout_width="fill_parent"
                        android:layout_height="200dp"
                        android:layout_below="@id/frente_text"
                        android:layout_alignParentStart="true"
                        android:layout_alignParentEnd="true"
                        android:layout_marginTop="5dp"
                        android:layout_marginBottom="5dp"
                        android:scaleType="fitCenter"
                        app:srcCompat="@drawable/frente_dni" />
                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/layout_imagen_dorso"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/layout_imagen"
                    android:layout_marginTop="3dp"
                    android:background="@drawable/style_rect"
                    android:gravity="center_horizontal|center"
                    android:padding="8dp">

                    <LinearLayout
                        android:id="@+id/dorso_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentLeft="true"
                        android:layout_alignParentRight="true"
                        android:layout_marginTop="5dp"
                        android:gravity="center_horizontal"
                        android:orientation="horizontal"
                        android:paddingLeft="5dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingLeft="20dp"
                            android:paddingRight="20dp"
                            android:paddingBottom="3dp"
                            android:text="Dorso del DNI"
                            android:textAlignment="center"
                            android:textSize="16dp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/imgDNIDorso"
                        android:layout_width="fill_parent"
                        android:layout_height="200dp"
                        android:layout_below="@id/dorso_text"
                        android:layout_alignParentStart="true"
                        android:layout_alignParentEnd="true"
                        android:layout_marginTop="5dp"
                        android:layout_marginBottom="5dp"
                        android:scaleType="fitCenter"
                        app:srcCompat="@drawable/dorso_dni" />
                </RelativeLayout>

            </RelativeLayout>
        </LinearLayout>
    </ScrollView>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_alignParentBottom="true"
        android:gravity="center"
        android:padding="5dp">

        <Button
            android:id="@+id/btnContinuarAGestos"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:background="@drawable/round_primary_button"
            android:text="@string/action_continuar"
            android:textSize="17sp"
            android:textStyle="bold" />
    </RelativeLayout>
</RelativeLayout>