<?xml version="1.0" encoding="utf-8"?>
<!-- Contacto: motivos de contacto. Estilo "D": cabecera turquesa y hoja blanca redondeada. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorPrimary"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp">

        <ImageView
            android:id="@+id/btn_return"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="Volver"
            android:padding="6dp"
            android:src="@drawable/ico_return_primary"
            android:tint="#FFFFFF" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fontFamily="@font/oswald"
            android:text="Contacto"
            android:textAllCaps="true"
            android:textColor="#FFFFFF"
            android:textSize="30sp" />

        <ImageView
            android:id="@+id/btn_cancel"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="Cerrar"
            android:padding="6dp"
            android:src="@drawable/ico_cancel_primary"
            android:tint="#FFFFFF" />
    </LinearLayout>

    <View
        android:layout_width="120dp"
        android:layout_height="4dp"
        android:layout_marginStart="64dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/subrayado_titulo" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/hoja_blanca"
        android:orientation="vertical">

        <ScrollView
            android:id="@+id/dialog_contact_scroll_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="22dp"
                android:paddingTop="22dp"
                android:paddingEnd="22dp"
                android:paddingBottom="8dp">

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_marginBottom="8dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_contacto_ayuda" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Seleccione el motivo de contacto"
                    android:textColor="@color/colorPrimary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="60dp"
                    android:layout_height="3dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="10dp"
                    android:background="@color/colorPrimary" />

                <LinearLayout
                    android:id="@+id/dialog_contact_subject_select"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>

        <!-- ids heredados (los usa HelperFunctions en otro cuadro); no se muestran -->
        <ImageView
            android:id="@+id/dialog_contact_go_down"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/dialog_contact_go_up"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <Button
                android:id="@+id/contact_estado"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:background="@drawable/boton_pildora_borde"
                android:fontFamily="@font/oswald"
                android:text="Estado de mi Fe de Vida"
                android:textAllCaps="true"
                android:textColor="@color/tu_tinta"
                android:textSize="18sp" />

            <Button
                android:id="@+id/contact_soporte"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/boton_pildora"
                android:fontFamily="@font/oswald"
                android:text="Contactar con soporte"
                android:textAllCaps="true"
                android:textColor="#FFFFFF"
                android:textSize="18sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
