<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorTransTotal"
    android:gravity="center"
    android:layout_marginHorizontal="5dp"
    android:orientation="vertical">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/style_rect"
        android:paddingBottom="10dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/btn_return"
                android:layout_width="30sp"
                android:layout_height="30sp"
                android:layout_marginLeft="5sp"
                android:src="@drawable/ico_return_primary" />
            <TextView
                android:id="@+id/text_title_info_empresarial"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:textSize="18sp"
                android:text="Seleccione el motivo de contacto"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="10sp"
                android:autoSizeMaxTextSize="18sp"
                android:autoSizeStepGranularity="2sp"
                android:layout_marginHorizontal="1dp"
                android:layout_marginVertical="4dp"
                android:textColor="@color/colorPrimary"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btn_cancel"
                android:layout_width="30sp"
                android:layout_height="30sp"
                android:layout_marginRight="5sp"
                android:src="@drawable/ico_cancel_primary" />
        </LinearLayout>


        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content" >


            <ScrollView
                android:id="@+id/dialog_contact_scroll_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fadeScrollbars="false"
                android:layout_gravity="center"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="2dp"
                    android:id="@+id/dialog_contact_subject_select"
                    android:orientation="vertical"/>

            </ScrollView>

            <ImageView
                android:id="@+id/dialog_contact_go_down"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="right|bottom"
                android:visibility="invisible"
                android:src="@drawable/ic_baseline_keyboard_double_arrow_down_24"
                app:tint="@color/colorPrimary" />

            <ImageView
                android:id="@+id/dialog_contact_go_up"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="right|top"
                android:visibility="invisible"
                android:src="@drawable/ic_baseline_keyboard_double_arrow_up_24"
                app:tint="@color/colorPrimary" />

        </FrameLayout>



    </LinearLayout>
</LinearLayout>

