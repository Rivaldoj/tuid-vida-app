<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_height="match_parent">


    <FrameLayout
        android:id="@+id/fireTopLayout"
        android:layout_width="match_parent"
        android:layout_weight="1"
        android:layout_height="wrap_content">

        <androidx.camera.view.PreviewView
            android:id="@+id/preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.autenticar.tuid.v2.components.ScannerFrontView
            android:layout_width="match_parent"
            android:visibility="invisible"
            android:layout_height="match_parent"/>


        <ImageButton
            android:id="@+id/fe_de_vida__rotate_camera"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/colorPrimary"
            android:src="@drawable/ic_baseline_cameraswitch_24"
            android:layout_gravity="right"
            android:layout_margin="20dp"
            app:tint="@color/white" />


        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/oval"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintTop_toTopOf="@id/ovalok"
                app:layout_constraintRight_toRightOf="@id/ovalok"
                app:layout_constraintBottom_toBottomOf="@id/ovalok"
                app:layout_constraintLeft_toLeftOf="@id/ovalok"
                android:src="@drawable/oval"/>

            <ImageView
                android:id="@+id/ovalok"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintWidth_percent="0.7"
                android:visibility="invisible"
                app:layout_constraintDimensionRatio="0.8"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                android:src="@drawable/oval_ok"/>

        </androidx.constraintlayout.widget.ConstraintLayout>



    </FrameLayout>

    <LinearLayout
        android:id="@+id/v2_activity_live_preview_container_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_alignParentBottom="true"
        android:gravity="center|bottom"
        android:orientation="vertical">

        <ProgressBar
            android:id="@+id/progressbar"
            style="@android:style/Widget.Holo.Light.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/lblGestosNecesarios"
            android:layout_marginBottom="5dp"
            android:indeterminate="true"
            android:indeterminateDuration="@integer/google_play_services_version"
            android:max="100"
            android:progressTint="@color/colorPrimary"
            android:theme="@style/GreenAccent" />

        <TextView
            android:id="@+id/lblGestosNecesarios"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            android:gravity="center_horizontal"
            android:padding="5dp"
            android:text="Capturando movimientos"
            android:textSize="15dp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/alertMessager"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:background="@color/colorPrimary"
            android:gravity="center|left"
            android:padding="10dp"
            android:text="No se detectan rostros"
            android:textColor="@color/white"
            android:textSize="15dp" />

    </LinearLayout>

</LinearLayout>