<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:buttonStyle">@style/AppButton</item>
        <item name="android:typeface">sans</item>
    </style>

    <style name="GreenAccent" parent="ThemeOverlay.AppCompat.Light">
        <item name="colorAccent">@color/lima</item>
    </style>

    <style name="TurquesaAccent" parent="ThemeOverlay.AppCompat.Light">
        <item name="colorAccent">@color/colorPrimary</item>
    </style>

    <style name="FullscreenTheme" parent="AppTheme">
        <item name="android:actionBarStyle">@style/FullscreenActionBarStyle</item>
        <item name="android:windowActionBarOverlay">true</item>
        <item name="android:windowBackground">@null</item>
        <item name="metaButtonBarStyle">?android:attr/buttonBarStyle</item>
        <item name="metaButtonBarButtonStyle">?android:attr/buttonBarButtonStyle</item>
    </style>

    <style name="FullscreenActionBarStyle" parent="Widget.AppCompat.ActionBar">
        <item name="android:background">@color/black_overlay</item>
    </style>

    <style name="AppTheme.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

    <style name="AppButton" parent="Base.Widget.AppCompat.Button">
        <item name="android:background">@drawable/round_primary_button</item>
        <item name="android:paddingStart">@dimen/padding</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:paddingEnd">@dimen/padding</item>
    </style>

    <style name="AppAccentButton" parent="AppButton">
        <item name="android:background">@drawable/round_accent_button</item>
    </style>

    <style name="BtnRegistre" parent="AppButton">
        <item name="android:background">@drawable/round_dark_button_2</item>
    </style>

    <style name="Etiquetas">
        <item name="android:background">@drawable/background_label_fab</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <!-- Cuadros de aviso con estilo "D": fondo blanco redondeado, sin marco del sistema -->
    <style name="DialogoTuID" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialogo_fondo</item>
        <item name="android:windowMinWidthMajor">90%</item>
        <item name="android:windowMinWidthMinor">90%</item>
        <item name="android:buttonStyle">@style/Widget.AppCompat.Button.Borderless</item>
    </style>

    <style name="Theme.AppCompat.modalmenu" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/colorTransTotal</item>
        <item name="android:windowIsTranslucent">true</item>
    </style>

    <!-- Menu lateral (nav_drawer_content.xml) -->
    <style name="NavFila">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">60dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingLeft">6dp</item>
        <item name="android:paddingRight">6dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>
    <style name="NavFilaIcono">
        <item name="android:layout_width">42dp</item>
        <item name="android:layout_height">42dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:importantForAccessibility">no</item>
    </style>
    <style name="NavFilaTexto">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginLeft">12dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">#2b2a2a</item>
    </style>
    <style name="NavSubtitulo">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingLeft">6dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:fontFamily">@font/oswald</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textColor">#01acc2</item>
    </style>
    <style name="NavSeparador">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:background">#dbe7ea</item>
    </style>
    <style name="NavSubrayado">
        <item name="android:layout_width">120dp</item>
        <item name="android:layout_height">4dp</item>
        <item name="android:layout_marginLeft">6dp</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:background">@drawable/subrayado_titulo_turquesa</item>
    </style>
</resources>
