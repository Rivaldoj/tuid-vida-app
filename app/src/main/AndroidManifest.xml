<!--                <action android:name="android.provider.Telephony.SMS_RECEIVED" />-->
<!--            </intent-filter>-->
<!--        </receiver>-->

        <activity
            android:name=".SplashActivity"
            android:label="@string/app_name"
            android:theme="@style/AppTheme.NoActionBar"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!--
<activity
            android:name=".utils.camera.CameraPreview"
            android:configChanges="orientation|keyboardHidden"
            android:label="@string/title_activity_registrar"
            android:screenOrientation="landscape"
            android:theme="@style/AppTheme.NoActionBar" />
        --> <!-- <activity android:name=".OcrCaptureActivity" /> -->

        <activity
            android:name=".HistoryActivity"
            android:label="@string/history" />
        <activity
            android:name=".v2.captura.PreCapturaActivity"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.NoActionBar" />
        <activity
            android:name=".usuarios.UsuariosActivity"
            android:label="Usuarios"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.NoActionBar" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/provider_paths" />
        </provider>
        <activity android:name=".v2.HomeActivity" android:screenOrientation="portrait" android:theme="@style/AppTheme.NoActionBar"/>
        <activity android:name=".avisos.AvisosActivity" android:screenOrientation="portrait" android:theme="@style/AppTheme.NoActionBar"/>
        <activity android:name=".v2.TerminosYCondicionesActivity"  android:screenOrientation="portrait" android:theme="@style/AppTheme.NoActionBar"/>
        <activity android:name=".v2.InstruccionesDniActivity" android:screenOrientation="portrait" android:theme="@style/AppTheme.NoActionBar"/>
        <activity android:name=".v2.ScanActivity" android:screenOrientation="portrait" android:theme="@style/AppTheme.NoActionBar"/>
        <activity android:name=".v2.ScanResultActivity" android:screenOrientation="portrait" android:theme="@style/AppTheme.NoActionBar" />
        <activity android:name=".v2.PreGestureActivity" android:screenOrientation="portrait" android:theme="@style/AppTheme.NoActionBar" />
        <activity android:name=".v2.FeDeVidaActivity"  android:screenOrientation="portrait" android:theme="@style/AppTheme.NoActionBar" />
        <activity android:name=".v2.ValidarTelefonoMail" android:screenOrientation="portrait" android:theme="@style/AppTheme.NoActionBar" />
        <activity android:name=".v2.ChanceActivity" android:screenOrientation="portrait" android:theme="@style/AppTheme.NoActionBar" />
        <activity android:name=".v2.EntidadesAdheridasActivity" android:screenOrientation="portrait" android:theme="@style/AppTheme.NoActionBar" />
        <activity android:name=".v2.CuandoCobroActivity" android:screenOrientation="portrait" android:theme="@style/AppTheme.NoActionBar" />
        <activity android:name=".v2.CertificadoActivity" android:screenOrientation="portrait" android:theme="@style/AppTheme.NoActionBar" />
        <activity android:name=".v2.ResultLoginActivity" android:screenOrientation="portrait" android:theme="@style/AppTheme.NoActionBar" />
        <activity android:name=".v2.RegistroManualActivity" android:exported="true" android:screenOrientation="portrait" android:theme="@style/AppTheme.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"></category>
                <category android:name="android.intent.category.BROWSABLE"></category>

                <data
                    android:host="com.autenticar.tuid"
                    android:path="/registroManual"
                    android:scheme="https"></data>

                <data
                    android:host="api.autenticartuid.com"
                    android:path="/manual"
                    android:scheme="https"></data>

            </intent-filter>
        </activity>
        <activity android:name=".v2.FormActivity" android:screenOrientation="portrait" />
        <activity android:name=".v2.TareasPendientesActivity" android:screenOrientation="portrait"/>
        <activity android:name=".v2.WebActivity" />
        <activity android:name=".v2.aws.LivenessActivity" android:screenOrientation="portrait" android:theme="@style/AppTheme.NoActionBar" />
        <service android:name=".utils.MyFirebaseMessagingService" android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <uses-library
            android:name="org.apache.http.legacy"
            android:required="false" />


    </application>

</manifest>